{
  "name": "dsh-plugin-2048",
  "version": "0.3.0",
  "description": "DeepSeek Harness 侧边栏 2048：连击、音效、5×5、每日挑战、战绩成就，以及会话完成/卡点时的游戏内提示。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/game.test.mjs && node test/plugin.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "2048",
    "game",
    "sidebar"
  ],
  "license": "MIT",
  "author": "JJJACKsong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJJACKsong/dsh-plugin-2048.git"
  },
  "homepage": "https://github.com/JJJACKsong/dsh-plugin-2048#readme",
  "bugs": {
    "url": "https://github.com/JJJACKsong/dsh-plugin-2048/issues"
  },
  "engines": {
    "dsh": ">=0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
